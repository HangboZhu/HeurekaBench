# API keys for closed-source LLMs
OPENAI_API_KEY=""
CLAUDE_API_KEY=""

# Model used by the claude_code backend (benchmark_creation, `--model_call claude_code`)
CLAUDE_CODE_MODEL=""

# Unified OpenAI-compatible gateway: used by `--model_call gateway` (insight
# extraction) and by the debate pipeline (debaters / judge / reviewer).
# Keys are tried in fallback order: OPENAI_KEY first, then CLAUDE_KEY (the
# keys may belong to different account groups serving different models).
BASE_URL=""
OPENAI_KEY=""
CLAUDE_KEY=""
# Comma-separated model names served by the gateway, e.g. model-a,model-b
MODEL_NAME=""

# Optional debate-role overrides (defaults: debaters = first two MODEL_NAME
# entries, judge = last MODEL_NAME entry, reviewer = claude_code local agent)
# DEBATE_MODELS=""
# JUDGE_MODEL=""
# REVIEW_MODEL=""
# INSIGHT_MODEL=""  # insight extraction model, default: first MODEL_NAME entry

# Huggingface related information (can be used to set before downloading models)
HF_TOKEN=""
HF_HOME=""

# Biomni-specific arguments
BIOMNI_DATA_PATH=""